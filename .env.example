APP_HOST=0.0.0.0
APP_PORT=8090

# Cliente liviano:
# usa la IP o hostname del servidor central y no carga Whisper/Ollama/Kokoro localmente.
# Ejemplo con Tailscale Serve:
# REMOTE_BACKEND_BASE_URL=https://tu-servidor.tu-tailnet.ts.net
# Ejemplo directo por LAN:
# REMOTE_BACKEND_BASE_URL=http://192.168.1.50:8090
REMOTE_BACKEND_BASE_URL=

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b-32k

# Solo aplica al servidor central.
WHISPER_MODEL=distil-large-v3
WHISPER_LANGUAGE=en
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_FALLBACK_DEVICE=cpu
WHISPER_FALLBACK_COMPUTE_TYPE=int8

# Solo aplica al servidor central.
TTS_VOICE=af_heart
TTS_REPO_ID=hexgrad/Kokoro-82M

GENERATED_RETENTION_SECONDS=3600
ENABLE_TAILSCALE_SERVE=1

# Solo aplica al servidor central: ruta de la base de datos SQLite
# (perfil de alumno, sesiones y turnos) y cuantos turnos recientes se
# reenvian al tutor como memoria de conversacion.
DB_PATH=backend/data/english46.db
RECENT_TURNS_LIMIT=6
